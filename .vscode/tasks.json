{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prism: build vscode-extension",
      "type": "shell",
      "command": "bun run --filter @repo-prism/intelligence build && bun run --filter @repo-prism/ui build && bun run --filter @repo-prism/app-shell build && bun run --filter @repo-prism/core build && bun run --filter @repo-prism/vscode-extension build",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "prism: build cursor-extension",
      "type": "shell",
      "command": "bun run --filter @repo-prism/cursor-extension build",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
