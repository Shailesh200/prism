{
  "name": "@repo-prism/daemon",
  "version": "2.0.0",
  "type": "module",
  "description": "Prism daemon — one local process that keeps each repository's graph indexed and fresh, and answers over loopback",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo-prism/core": "workspace:*",
    "@repo-prism/shared": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shailesh200/prism.git"
  },
  "homepage": "https://www.prismhq.in",
  "bugs": {
    "url": "https://github.com/Shailesh200/prism/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
