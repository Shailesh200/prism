{
  "name": "@repo-prism/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared React Map and explorer UI",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map.css": "./src/map.css",
    "./tokens.css": "./src/tokens.css",
    "./primitives.css": "./src/primitives.css"
  },
  "files": [
    "dist",
    "src/*.css",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run build:css",
    "build:css": "bun -e \"await Bun.write('dist/tokens.css', await Bun.file('src/tokens.css').text()); await Bun.write('dist/map.css', await Bun.file('src/map.css').text()); await Bun.write('dist/primitives.css', await Bun.file('src/primitives.css').text())\"",
    "gen:icons": "node scripts/gen-material-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@repo-prism/shared": "workspace:*",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@xyflow/react": "^12.11.2",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "material-icon-theme": "^5.37.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
