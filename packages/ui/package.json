{
  "name": "@repo-prism/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prism design tokens and motion vocabulary (website)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run build:css",
    "build:css": "bun -e \"await Bun.write('dist/tokens.css', await Bun.file('src/tokens.css').text())\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo-prism/shared": "workspace:*"
  }
}
