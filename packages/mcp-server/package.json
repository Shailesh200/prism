{
  "name": "@prism/mcp-server",
  "version": "0.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prism/core": "workspace:*",
    "@prism/shared": "workspace:*",
    "zod": "^3.25.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
