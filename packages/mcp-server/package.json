{
  "name": "@repo-prism/mcp-server",
  "version": "2.0.0",
  "mcpName": "io.github.Shailesh200/prism",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@repo-prism/checks": "workspace:*",
    "@repo-prism/core": "workspace:*",
    "@repo-prism/daemon": "workspace:*",
    "@repo-prism/shared": "workspace:*",
    "zod": "^3.25.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "prism-mcp": "./dist/bin.js"
  },
  "description": "MCP server over Core: local repository intelligence for coding agents",
  "files": [
    "dist",
    "media"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@repo-prism/test-support": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shailesh200/prism.git"
  },
  "homepage": "https://www.prismhq.in",
  "bugs": {
    "url": "https://github.com/Shailesh200/prism/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
