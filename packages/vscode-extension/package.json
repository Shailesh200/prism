{
  "name": "@prism/vscode-extension",
  "displayName": "RepoPrism",
  "description": "RepoPrism (repo prism) — local-first Software Intelligence: Repository Map, Overview, Blast Radius, Health, and Domains for VS Code and Cursor",
  "version": "0.1.6",
  "private": true,
  "publisher": "prismhq",
  "type": "module",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "repoprism",
    "repo prism",
    "repo-prism",
    "prismhq",
    "prism",
    "repository-map",
    "local-first",
    "blast-radius",
    "code-intelligence",
    "software-intelligence"
  ],
  "icon": "media/prism-mark.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shailesh200/prism"
  },
  "bugs": {
    "url": "https://github.com/Shailesh200/prism/issues"
  },
  "homepage": "https://github.com/Shailesh200/prism",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "prism.open",
        "title": "Open Prism",
        "category": "Prism"
      },
      {
        "command": "prism.openRepositoryMap",
        "title": "Open Repository Map",
        "category": "Prism"
      },
      {
        "command": "prism.showHealth",
        "title": "Show Health",
        "category": "Prism"
      },
      {
        "command": "prism.reindex",
        "title": "Reindex",
        "category": "Prism"
      },
      {
        "command": "prism.openInBrowser",
        "title": "Open in Browser",
        "category": "Prism"
      }
    ]
  },
  "files": [
    "dist",
    "media",
    "README.md",
    "LICENSE",
    "PUBLISH.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "package:vsix": "bun run scripts/package-vsix.ts",
    "publish:vsix": "bun run scripts/package-vsix.ts --publish",
    "publish:ovsx": "bunx ovsx publish"
  },
  "dependencies": {
    "@prism/app-shell": "workspace:*",
    "@prism/core": "workspace:*",
    "@prism/shared": "workspace:*",
    "@prism/ui": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "ovsx": "^0.10.6"
  }
}
