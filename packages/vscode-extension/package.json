{
  "name": "@prism/vscode-extension",
  "displayName": "RepoPrism",
  "description": "RepoPrism (repo prism) — local-first Software Intelligence: Repository Map, Overview, Blast Radius, Health, and Domains for VS Code and Cursor",
  "version": "0.1.11",
  "private": true,
  "publisher": "prismhq",
  "type": "module",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "prism",
    "RepoPrism",
    "repoprism",
    "repo prism",
    "repo-prism",
    "prismhq",
    "repository map",
    "repository-map",
    "code map",
    "codebase map",
    "blast radius",
    "blast-radius",
    "impact analysis",
    "change impact",
    "health score",
    "code health",
    "domain map",
    "domains",
    "knowledge graph",
    "code intelligence",
    "software intelligence",
    "local-first",
    "monorepo",
    "vscode",
    "cursor"
  ],
  "icon": "media/prism-mark.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shailesh200/prism"
  },
  "bugs": {
    "url": "https://github.com/Shailesh200/prism/issues"
  },
  "homepage": "https://github.com/Shailesh200/prism",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "prism.open",
        "title": "Open Prism",
        "category": "Prism"
      },
      {
        "command": "prism.openRepositoryMap",
        "title": "Open Repository Map",
        "category": "Prism"
      },
      {
        "command": "prism.showHealth",
        "title": "Show Health",
        "category": "Prism"
      },
      {
        "command": "prism.reindex",
        "title": "Reindex",
        "category": "Prism"
      },
      {
        "command": "prism.openInBrowser",
        "title": "Open in Browser",
        "category": "Prism"
      },
      {
        "command": "prism.blastRadius",
        "title": "Blast Radius",
        "category": "Prism"
      },
      {
        "command": "prism.safeDelete",
        "title": "Safe Delete Check",
        "category": "Prism"
      },
      {
        "command": "prism.exploreOwnership",
        "title": "Explore Ownership",
        "category": "Prism"
      },
      {
        "command": "prism.revealOnMap",
        "title": "Reveal on Map",
        "category": "Prism"
      },
      {
        "command": "prism.explainArea",
        "title": "Explain This Area",
        "category": "Prism"
      },
      {
        "command": "prism.reviewChanges",
        "title": "Review Changes",
        "category": "Prism"
      },
      {
        "command": "prism.openWalkthrough",
        "title": "Getting Started Tour",
        "category": "Prism"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "prism.blastRadius",
          "group": "prism@1"
        },
        {
          "command": "prism.safeDelete",
          "group": "prism@2"
        },
        {
          "command": "prism.exploreOwnership",
          "group": "prism@3"
        },
        {
          "command": "prism.explainArea",
          "group": "prism@4"
        },
        {
          "command": "prism.revealOnMap",
          "group": "prism@5"
        }
      ],
      "explorer/context": [
        {
          "command": "prism.blastRadius",
          "group": "prism@1"
        },
        {
          "command": "prism.safeDelete",
          "group": "prism@2"
        },
        {
          "command": "prism.exploreOwnership",
          "group": "prism@3"
        },
        {
          "command": "prism.explainArea",
          "group": "prism@4"
        },
        {
          "command": "prism.revealOnMap",
          "group": "prism@5"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "prism.reviewChanges",
          "group": "prism@1"
        },
        {
          "command": "prism.blastRadius",
          "group": "prism@2"
        }
      ]
    },
    "configuration": {
      "title": "Prism",
      "properties": {
        "prism.codeLens.enabled": {
          "type": "boolean",
          "default": false,
          "title": "Enable CodeLens",
          "description": "Show file-level Prism CodeLenses (Blast Radius, Ownership, Map) above the first line of each file. Also available in Prism → Settings → General.",
          "order": 1
        }
      }
    }
  },
  "files": [
    "dist",
    "media",
    "README.md",
    "LICENSE",
    "PUBLISH.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "package:vsix": "bun run scripts/package-vsix.ts",
    "publish:vsix": "bun run scripts/package-vsix.ts --publish",
    "publish:ovsx": "bunx ovsx publish"
  },
  "dependencies": {
    "@prism/app-shell": "workspace:*",
    "@prism/core": "workspace:*",
    "@prism/shared": "workspace:*",
    "@prism/ui": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "ovsx": "^0.10.6"
  }
}
