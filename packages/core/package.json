{
  "name": "@repo-prism/core",
  "version": "1.0.1",
  "type": "module",
  "description": "Public Core SDK façade — only supported integration surface",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@repo-prism/analyzer": "workspace:*",
    "@repo-prism/impact": "workspace:*",
    "@repo-prism/indexer": "workspace:*",
    "@repo-prism/intelligence": "workspace:*",
    "@repo-prism/navigation": "workspace:*",
    "@repo-prism/repository-map": "workspace:*",
    "@repo-prism/shared": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@repo-prism/test-support": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shailesh200/prism.git"
  },
  "homepage": "https://www.prismhq.in",
  "bugs": {
    "url": "https://github.com/Shailesh200/prism/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
