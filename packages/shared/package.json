{
  "name": "@repo-prism/shared",
  "version": "1.3.0",
  "type": "module",
  "description": "Shared contracts, DTOs, errors, Zod schemas",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prism-home": {
      "types": "./dist/prism-home.d.ts",
      "import": "./dist/prism-home.js"
    },
    "./user-config": {
      "types": "./dist/user-config.d.ts",
      "import": "./dist/user-config.js"
    },
    "./lens-store": {
      "types": "./dist/lens-store.d.ts",
      "import": "./dist/lens-store.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./prism-bin": {
      "types": "./dist/prism-bin.d.ts",
      "import": "./dist/prism-bin.js"
    },
    "./git-head": {
      "types": "./dist/git-head.d.ts",
