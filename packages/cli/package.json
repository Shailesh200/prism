{
  "name": "@repo-prism/cli",
  "version": "2.0.0",
  "type": "module",
  "description": "Prism CLI — your agent's second pair of eyes: Prepare before it edits, lens review after. Free, runs on your machine",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "prism": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@repo-prism/core": "workspace:*",
    "@repo-prism/daemon": "workspace:*",
    "@repo-prism/mcp-server": "workspace:*",
    "@repo-prism/plugin": "workspace:*",
    "@repo-prism/shared": "workspace:*",
    "commander": "^15.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shailesh200/prism.git"
  },
  "homepage": "https://www.prismhq.in",
  "bugs": {
    "url": "https://github.com/Shailesh200/prism/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@repo-prism/test-support": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
